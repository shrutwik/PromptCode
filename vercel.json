{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh https://cdn.jsdelivr.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://esm.sh https://cdn.jsdelivr.net; worker-src 'self' blob: https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ],
  "redirects": [
    { "source": "/login", "destination": "/frontend/login.html", "permanent": false },
    { "source": "/signup", "destination": "/frontend/signup.html", "permanent": false },
    { "source": "/practice", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shrutwik2006--promptcode-fastapi-app.modal.run/api/:path*"
    },
    { "source": "/static/:path*", "destination": "/frontend/:path*" },
    { "source": "/challenges/:slug", "destination": "/frontend/interview-challenge.html" },
    { "source": "/challenges", "destination": "/frontend/interview-challenges.html" },
    { "source": "/session/:id/report", "destination": "/frontend/interview-report.html" },
    { "source": "/session/:id", "destination": "/frontend/interview-session.html" },
    { "source": "/dashboard", "destination": "/frontend/interview-dashboard.html" },
    { "source": "/onboarding", "destination": "/frontend/interview-onboarding.html" },
    { "source": "/privacy", "destination": "/frontend/interview-privacy.html" },
    { "source": "/settings", "destination": "/frontend/interview-settings.html" },
    { "source": "/progress", "destination": "/frontend/interview-progress.html" },
    { "source": "/grading", "destination": "/frontend/interview-grading.html" },
    { "source": "/((?!api/|static/|frontend/).*)", "destination": "/frontend/index.html" }
  ]
}
