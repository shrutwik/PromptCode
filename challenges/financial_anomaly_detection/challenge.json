    "accuracy_mode": "json",
    "expected_calls": 3,
    "processing_rules": {
      "exclude_test_accounts": "Transactions from accounts prefixed with 'TEST-' or 'SANDBOX-' must be completely ignored in all analysis",
      "exclude_reversed_transactions": "Transactions with status 'reversed' or 'cancelled' are already handled and must not be flagged or included in chains",
      "internal_transfers_exempt": "Transactions with type 'internal_transfer' between accounts owned by the same holder (same account prefix before the dash) are exempt from anomaly detection",
      "timezone_awareness": "All timestamps are in UTC. Geo-impossibility should use realistic travel times: same-city = 0 min, adjacent-metro = 60 min, cross-country = 240 min, international = 480 min",
      "structuring_threshold": "The CTR reporting threshold is $10,000. Structuring is defined as 3+ transfers from the same account within a 7-day window where each amount is between $8,000 and $9,999 and they go to different recipients",
      "weekend_exclusion": "Saturday/Sunday transactions that are automated bill pays (type 'auto_bill_pay') should not be flagged for pattern_break even if they deviate from weekday patterns",
      "merchant_normalization": "Merchant names may vary (e.g., 'STARBUCKS #4412' vs 'Starbucks #4412'). Treat as same merchant when normalized to lowercase+stripped matches",
      "confidence_scoring": "Confidence must reflect: geo_impossible >= 0.95, structuring >= 0.90, round_trip >= 0.85, velocity >= 0.80, pattern_break >= 0.70, amount >= 0.60"
    },
