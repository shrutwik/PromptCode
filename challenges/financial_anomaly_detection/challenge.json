        "timestamp": "2024-02-15T10:00:00Z",
        "amount": 500,
        "type": "withdrawal",
        "location": "New York"
      }
    ]
  },
  "sample_output": {
    "flagged_transactions": [],
    "suspicious_chains": []
  },
