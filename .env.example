# Copy to .env and fill in values
OPENAI_API_KEY=sk-your-key-here

# Backend config (all prefixed with PROMPTCODE_)

# --- Database (choose one) ---
# Local Docker Postgres (default):
PROMPTCODE_DATABASE_URL=postgresql+asyncpg://promptcode:promptcode@localhost:5432/promptcode

# Supabase: use Connection string from Project Settings → Database.
# Use "URI" and replace postgresql:// with postgresql+asyncpg://
# Session pooler (port 5432) or Transaction pooler (port 6543) both work.
# Example (replace [YOUR-PASSWORD] and [project-ref] / [region]):
# PROMPTCODE_DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Required for Supabase (SSL):
# PROMPTCODE_DATABASE_SSL_REQUIRE=true
# Optional CA bundle path for verified TLS:
# PROMPTCODE_DATABASE_SSL_CA_FILE=/etc/ssl/certs/ca-certificates.crt

PROMPTCODE_DATABASE_SSL_REQUIRE=false
PROMPTCODE_DATABASE_SSL_CA_FILE=
PROMPTCODE_OPENAI_API_KEY=sk-your-key-here
PROMPTCODE_DEBUG=true
PROMPTCODE_EVALUATION_WEIGHT_PROFILE_PATH=
PROMPTCODE_EVALUATION_WEIGHT_PROFILE_LOCK_PATH=
PROMPTCODE_EVALUATION_WEIGHT_PROFILE_ENFORCE_LOCK=true
PROMPTCODE_SANDBOX_IMAGE=promptcode-sandbox:latest
PROMPTCODE_SANDBOX_TIMEOUT_SECONDS=120
PROMPTCODE_EVALUATION_NORMAL_RUNS=5
PROMPTCODE_EVALUATION_ADVERSARIAL_RUNS=2
