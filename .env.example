# Optional: only needed when running the SDK directly outside PromptCode.
OPENAI_API_KEY=

# Backend config (all prefixed with PROMPTCODE_)
# Required for production: public hostname Caddy will serve TLS for.
# Leave blank in local dev; set a real hostname in /opt/promptcode/.env on the host.
DOMAIN=

# --- Database (choose one) ---
# Local Docker Postgres (default):
PROMPTCODE_DATABASE_URL=postgresql+asyncpg://promptcode:promptcode@localhost:5433/promptcode
# Host port published by docker compose for the local Postgres container.
PROMPTCODE_DB_PORT=5433
# Required by docker compose to initialise the Postgres container and construct the
# internal DATABASE_URL. Must match the password embedded in PROMPTCODE_DATABASE_URL above.
PROMPTCODE_DB_PASSWORD=promptcode
# Docker Compose overrides this value inside containers to use the internal `db` host.

# Supabase: use Connection string from Project Settings → Database.
# Use "URI" and replace postgresql:// with postgresql+asyncpg://
# Prefer the Session pooler (port 5432). The Transaction pooler (port 6543) breaks
# server-side prepared statements unless the driver disables its statement cache
# (asyncpg statement_cache_size=0); see the managed-deployment section at the end of
# this file. Direct connections are IPv6-only on the free plan.
# Example (replace [YOUR-PASSWORD] and [project-ref] / [region]):
# PROMPTCODE_DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
# Required for Supabase (SSL):
# PROMPTCODE_DATABASE_SSL_REQUIRE=true
# Optional CA bundle path for verified TLS:
# PROMPTCODE_DATABASE_SSL_CA_FILE=/etc/ssl/certs/ca-certificates.crt

PROMPTCODE_DATABASE_SSL_REQUIRE=false
PROMPTCODE_DATABASE_SSL_CA_FILE=
PROMPTCODE_OPENAI_API_KEY=
PROMPTCODE_OPENAI_BASE_URL=https://api.deepseek.com
PROMPTCODE_OPENAI_MODEL=deepseek-flash
# DeepSeek uses DEEPSEEK_API_KEY below; legacy provider keys are never reused.
PROMPTCODE_AI_PROVIDER=deepseek
PROMPTCODE_AI_MODEL=deepseek-flash
# Legacy challenge code may request an older provider's model id. Each id listed here
# is accepted from a candidate sandbox and mapped to PROMPTCODE_AI_MODEL before any
# paid call. Empty accepts only the models a challenge declares, so no vendor is
# assumed. Example: gpt-4o,gpt-4o-mini
PROMPTCODE_AI_MODEL_ALIASES=
PROMPTCODE_AI_BASE_URL=https://api.deepseek.com
PROMPTCODE_AI_API_KEY=
PROMPTCODE_PROMPT_JUDGE_MODEL=deepseek-flash
PROMPTCODE_PROMPT_JUDGE_FALLBACK_MODEL=deepseek-flash
PROMPTCODE_JWT_SECRET=replace-this-with-a-long-random-secret
# Proxy CIDRs allowed to supply X-Forwarded-For / X-Real-IP for auth rate limiting.
# Keep loopback-only for local/dev. The production compose override widens this to Docker bridge
# ranges so the Caddy container can forward the real client IP safely.
PROMPTCODE_AUTH_TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
# JSON list of allowed CORS origins. Restrict to your real domain(s) in production.
PROMPTCODE_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]
PROMPTCODE_DEBUG=false
PROMPTCODE_DATABASE_ECHO=false
PROMPTCODE_EVALUATION_WEIGHT_PROFILE_PATH=
PROMPTCODE_EVALUATION_WEIGHT_PROFILE_LOCK_PATH=
PROMPTCODE_EVALUATION_WEIGHT_PROFILE_ENFORCE_LOCK=true
PROMPTCODE_SANDBOX_IMAGE=promptcode-sandbox:latest
PROMPTCODE_SANDBOX_HOST_WORKDIR=/tmp/promptcode_sandbox_work
# none = fully isolated (recommended for local dev and production).
# container = share the executor's network namespace so the sandbox can reach the LLM relay
#             (set automatically by docker-compose via PROMPTCODE_SANDBOX_NETWORK_MODE=container).
PROMPTCODE_SANDBOX_NETWORK_MODE=none
PROMPTCODE_SANDBOX_TIMEOUT_SECONDS=120
PROMPTCODE_SANDBOX_MEMORY_LIMIT=512m
PROMPTCODE_SANDBOX_CPU_LIMIT=1.0
PROMPTCODE_SANDBOX_EXECUTOR_URL=
# Shared secret between backend and sandbox-executor. Required; must be identical on both sides.
PROMPTCODE_SANDBOX_EXECUTOR_TOKEN=replace-this-with-a-random-secret
PROMPTCODE_SANDBOX_EXECUTOR_MAX_CONCURRENT_RUNS=6
PROMPTCODE_SANDBOX_EXECUTOR_ACQUIRE_TIMEOUT_SECONDS=10
PROMPTCODE_EVALUATION_NORMAL_RUNS=5
PROMPTCODE_EVALUATION_ADVERSARIAL_RUNS=2
PROMPTCODE_EVALUATION_MAX_PARALLEL_SPECS=2
PROMPTCODE_EVALUATION_JOB_TIMEOUT_SECONDS=1800
PROMPTCODE_SUBMISSION_INLINE_QUEUE_PROCESSING=true
# NOTE: When inline processing is enabled, no persistent worker runs, so the periodic global
# cleanup of auth_rate_limit_events (every 5 min) does NOT execute. Stale rows are pruned
# per-request for the requesting key only. Switch to inline=false + run_queue_worker for
# full global cleanup. This is an accepted operational tradeoff for single-process deployments.
# Limits only queued/running jobs per user; repeat attempts remain unlimited over time.
PROMPTCODE_SUBMISSION_MAX_OUTSTANDING_JOBS_PER_USER=3
PROMPTCODE_WORKER_HEARTBEAT_INTERVAL_SECONDS=5
PROMPTCODE_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30

# Error tracking — leave empty to disable Sentry
# Get DSN from https://sentry.io → Project Settings → Client Keys
PROMPTCODE_SENTRY_DSN=

# Prometheus metrics — set a secret string to allow scraping via
# Authorization: Bearer <token> on GET /metrics.
# When PROMPTCODE_DEBUG=false and this is empty, /metrics returns 401 (fail closed).
PROMPTCODE_METRICS_TOKEN=

# Docker group GID for sandbox-executor (runs as non-root user but needs Docker socket access).
# Get the correct value with: stat -c '%g' /var/run/docker.sock
# Default 999 matches most Linux distros; override if different on your host.
DOCKER_GID=999

# GHCR pull auth for host restarts and rollbacks.
# If both backend and sandbox packages are public, set PROMPTCODE_GHCR_PUBLIC_IMAGES=true
# and leave GHCR_USERNAME / GHCR_TOKEN blank.
PROMPTCODE_GHCR_PUBLIC_IMAGES=false
GHCR_USERNAME=
GHCR_TOKEN=

# ── GitHub Actions CD secrets ──────────────────────────────────────────────────
# Set these in GitHub → Settings → Secrets and variables → Actions.
# The deploy job is skipped automatically if DEPLOY_HOST is not set.
#
# DOMAIN           — Public hostname Caddy binds and obtains TLS for (e.g. api.example.com)
# DEPLOY_HOST      — IP or hostname of the production server
# DEPLOY_USER      — SSH user on that server (e.g. ubuntu, deploy)
# DEPLOY_SSH_KEY   — Private key whose public half is in ~/.ssh/authorized_keys
#
# ── Production CORS override (optional) ───────────────────────────────────────
# By default, only https://<DOMAIN> is allowed. Override here for split-origin
# deployments (e.g. frontend on a CDN, API on a separate subdomain):
# PROMPTCODE_CORS_ORIGINS=["https://www.example.com","https://api.example.com"]
#
# ── Database backups ──────────────────────────────────────────────────────────
# scripts/backup-db.sh performs pg_dump + gzip with 7-day local retention.
# To schedule daily backups at 03:00, add to the deploy user's crontab:
#   0 3 * * * /opt/promptcode/scripts/backup-db.sh >> /opt/promptcode/backups/backup.log 2>&1
# For off-host upload, install rclone and set:
RCLONE_REMOTE=
#
# On first setup, run on the host:
#   mkdir -p /opt/promptcode
#   cp .env.example /opt/promptcode/.env   # then fill in real values
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# ── Alerting ──────────────────────────────────────────────────────────────────
# There is no alert manager in this stack. scripts/check-prod-health.sh,
# scripts/backup-db.sh and the deploy workflow call scripts/notify-alert.sh,
# which is a no-op until one of these is set. Configure one BEFORE launch, or
# failures will only appear in cron mail and workflow logs.
#   PROMPTCODE_ALERT_WEBHOOK_URL — POSTs a JSON body (Slack/Teams/Alertmanager relay)
#   PROMPTCODE_ALERT_COMMAND     — command invoked with the message as its first argument
# PROMPTCODE_ALERT_WEBHOOK_URL=
# PROMPTCODE_ALERT_COMMAND=
# PROMPTCODE_ALERT_TIMEOUT=10
# PROMPTCODE_ALERT_TOPIC=promptcode

# --- Interview beta ---
PROMPTCODE_SESSION_TTL_HOURS=24
# Concurrent candidate executions. Raise only with measured evidence: every slot
# is a bounded container on the execution host.
PROMPTCODE_MAX_RUNNERS=4
# Bounded waiting instead of instant shedding. Requests queue FIFO up to
# MAX_RUNNER_WAITERS and wait at most MAX_RUNNERS_ACQUIRE_TIMEOUT_SECONDS; beyond
# either bound admission fails closed with 503 + Retry-After.
PROMPTCODE_MAX_RUNNERS_ACQUIRE_TIMEOUT_SECONDS=15
PROMPTCODE_MAX_RUNNER_WAITERS=32
# Independent grading probes run inside one admitted execution slot. Raising this
# shortens slot occupancy but adds concurrent probe containers on the execution
# host; raise only with measured host evidence.
PROMPTCODE_PROBE_CONCURRENCY=2
# Database budgets. The statement timeout must exceed the pool wait, otherwise a
# transaction queued behind the pool is killed mid-statement (validation enforces
# COMMAND > POOL). Connections per process = POOL + OVERFLOW; size them against
# the database's max_connections across all API and worker processes.
PROMPTCODE_DATABASE_POOL_SIZE=20
PROMPTCODE_DATABASE_MAX_OVERFLOW=10
PROMPTCODE_DATABASE_POOL_TIMEOUT_SECONDS=15
PROMPTCODE_DATABASE_COMMAND_TIMEOUT_SECONDS=30
PROMPTCODE_DATABASE_CONNECT_TIMEOUT_SECONDS=5
PROMPTCODE_INTERVIEW_MAX_AI_REQUESTS_PER_SESSION=150
PROMPTCODE_AUTH_COOKIE_ENABLED=false
PROMPTCODE_AUTH_COOKIE_SECURE=true
PROMPTCODE_AUTH_COOKIE_SAMESITE=lax
PROMPTCODE_FRONTEND_URL=
PROMPTCODE_APP_VERSION=0.1.0-beta
PROMPTCODE_LOG_LEVEL=INFO
# docker in production compose. Set local only for a laptop process, and only
# with PROMPTCODE_ALLOW_UNSAFE_LOCAL_RUNNER=1.
PROMPTCODE_RUNNER=docker
PROMPTCODE_INTERVIEW_INTERNAL_TOKEN=change-me-internal-token
PROMPTCODE_INTERVIEW_WORKSPACE_ROOT=
# Private beta gate (existing users unaffected; only blocks new signup without invite/allowlist)
PROMPTCODE_BETA_INVITE_REQUIRED=false
PROMPTCODE_BETA_EMAIL_ALLOWLIST=
PROMPTCODE_BETA_DEFAULT_COHORT=beta
PROMPTCODE_BETA_STARTER_CHALLENGE=invoice-status-transition
PROMPTCODE_GIT_SHA=
DEEPSEEK_API_KEY=
# Separate evaluator/result-authentication secret, at least 32 random bytes.
PROMPTCODE_GRADING_SIGNING_KEY=
PROMPTCODE_GRADING_FEEDBACK_ENABLED=false
PROMPTCODE_GRADING_PUBLISH_REVIEWED_SCORES=false
PROMPTCODE_GRADING_CALIBRATION_REPORT_PATH=
PROMPTCODE_GRADING_JOB_TIMEOUT_SECONDS=600
PROMPTCODE_GRADING_MAX_PENDING_JOBS=100
PROMPTCODE_INTERVIEW_STORAGE_MAX_BYTES=21474836480
PROMPTCODE_INTERVIEW_STORAGE_MIN_FREE_BYTES=2147483648
PROMPTCODE_GRADING_QUEUE_ALERT_SECONDS=300
PROMPTCODE_GRADING_FAILED_ALERT_JOBS=1
# Production app connects to a separate execution host over HTTPS.
PROMPTCODE_EXECUTION_BROKER_URL=
# Optional trusted private CA PEM, mounted read-only into application services.
PROMPTCODE_EXECUTION_BROKER_CA_FILE=
# Broker-host role only: never copy the application's .env to that host.
PROMPTCODE_EXECUTION_BROKER_MODE=false
PROMPTCODE_BROKER_NODE_IMAGE=
PROMPTCODE_BROKER_PYTHON_IMAGE=

# Assistant reservations: USD micros; conservative Flash rate; failures remain charged.
PROMPTCODE_AI_QUESTION_ONLY=true
PROMPTCODE_AI_KILL_SWITCH=false
PROMPTCODE_AI_MAX_MICROS_PER_TOKEN=2
PROMPTCODE_AI_GLOBAL_REQUESTS=3000
PROMPTCODE_AI_GLOBAL_TOKENS=7500000
PROMPTCODE_AI_GLOBAL_COST_MICROS=15000000
PROMPTCODE_AI_USER_REQUESTS=300
PROMPTCODE_AI_USER_TOKENS=7500000
PROMPTCODE_AI_USER_COST_MICROS=15000000
PROMPTCODE_AI_SESSION_REQUESTS=150
PROMPTCODE_AI_SESSION_TOKENS=3750000
PROMPTCODE_AI_SESSION_COST_MICROS=7500000
# The lifetime/trial ceiling is OPT-IN and has no default monetary cap. Removing the
# old hardcoded $5 does not allow unlimited spending: the global/user/session caps
# above and the kill switch stay enforced. Enable to add a lifetime ceiling.
PROMPTCODE_AI_TRIAL_ENABLED=false
PROMPTCODE_AI_TRIAL_REQUESTS=1000000
PROMPTCODE_AI_TRIAL_TOKENS=1000000000
PROMPTCODE_AI_TRIAL_COST_MICROS=5000000

# ══════════════════════════════════════════════════════════════════════════════
# Managed deployment profile: Vercel (static frontend) + Modal (backend) +
# Supabase (Postgres + private object storage).
# Use this instead of the docker-compose host profile when deploying managed.
# Full operator runbook: docs/managed-deployment.md
#
# Verified provider limits this profile is built around (attributed):
#   * Modal web endpoints time out after 150 s, and their 303 result-URL fallback
#     cannot populate CORS headers — so no HTTP request may wait for grading:
#     https://modal.com/docs/guide/webhook-timeouts
#   * Modal requires a payment method on file; set the workspace spend limit to $0 so
#     credits are never exceeded into out-of-pocket charges (Usage & Billing → Spend
#     limit): https://modal.com/docs/guide/budgets
#   * Supabase free plan: 500 MB database, 1 GB storage, 5 GB egress, 50 MB maximum
#     single object, project paused after 7 days without database activity, 60 direct
#     connections, direct connections are IPv6-only, no automated backups:
#     https://supabase.com/pricing
#     https://supabase.com/docs/guides/platform/free-project-pausing
#   * Supabase transaction pooler (port 6543) breaks prepared statements unless the
#     driver disables its statement cache; the session pooler (port 5432) does not:
#     https://supabase.com/docs/guides/troubleshooting/disabling-prepared-statements-qL8lEL
#   * Vercel Hobby is for non-commercial personal use only:
#     https://vercel.com/docs/plans/hobby — do not claim commercial production
#     readiness on Hobby. Hobby hard-stops when limits are exceeded (no billing).
# ══════════════════════════════════════════════════════════════════════════════

# Candidate/trusted execution backend: "docker" = the self-managed host above,
# "modal" = Modal Sandboxes. Modal mode requires both Modal sandbox image ids below,
# storage_backend=supabase, and a non-placeholder PROMPTCODE_GRADING_SIGNING_KEY.
# It does not require PROMPTCODE_RUNNER=docker, an execution broker URL, or a broker
# management token; a broker/executor URL stays allowed if the trusted-evaluation
# path is wired through it. It must not run the Docker broker role itself
# (PROMPTCODE_EXECUTION_BROKER_MODE=false).
PROMPTCODE_EXECUTION_BACKEND=docker

# --- Modal (backend host) ---
# App name for `modal deploy backend/modal_app.py` and for spawning the background
# grading function. Modal reads MODAL_TOKEN_ID / MODAL_TOKEN_SECRET from its own
# secret store — never put them in this file, the frontend or a sandbox.
PROMPTCODE_MODAL_APP_NAME=promptcode
# Optional Modal environment; empty uses the active CLI/root environment.
PROMPTCODE_MODAL_ENVIRONMENT=
# Sandbox images for candidate execution (Node and Python). Both required for modal.
PROMPTCODE_MODAL_SANDBOX_IMAGE_NODE=
PROMPTCODE_MODAL_SANDBOX_IMAGE_PYTHON=
# Per-sandbox bounds. Keep the sandbox timeout below the 150 s web-request cap: an
# execution backend must never make an HTTP request wait on a sandbox.
PROMPTCODE_MODAL_SANDBOX_TIMEOUT_SECONDS=120
PROMPTCODE_MODAL_SANDBOX_CPU=1.0
PROMPTCODE_MODAL_SANDBOX_MEMORY_MB=1024
# Candidate output is truncated to this many bytes before it leaves the sandbox.
PROMPTCODE_MODAL_SANDBOX_OUTPUT_LIMIT_BYTES=131072
PROMPTCODE_MODAL_SANDBOX_PIDS_LIMIT=128
# Budget for one background grading run (backend/modal_app.py). This is a Function,
# not a web endpoint, so it is not bound by the 150 s HTTP cap.
PROMPTCODE_MODAL_FUNCTION_TIMEOUT_SECONDS=1500
# Legacy interview runner. A Modal deployment leaves this at "local" (candidate code
# is executed by the Modal execution backend, not by the API process) and keeps
# PROMPTCODE_ALLOW_UNSAFE_LOCAL_RUNNER=false.
# PROMPTCODE_RUNNER=local

# --- Supabase (Postgres + private object storage) ---
# "filesystem" keeps the self-managed host layout; "supabase" is required for modal.
PROMPTCODE_STORAGE_BACKEND=filesystem
# Project URL, e.g. https://abcdefghijklm.supabase.co
PROMPTCODE_SUPABASE_URL=
# Service-role key. Trusted backend only: never expose it to the frontend, and never
# inject it into a candidate sandbox.
PROMPTCODE_SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for submissions/snapshots.
PROMPTCODE_SUPABASE_STORAGE_BUCKET=promptcode-private
PROMPTCODE_SUPABASE_STORAGE_TIMEOUT_SECONDS=30
# Must not exceed 50 MB (50331648), the Supabase free-plan per-object limit.
PROMPTCODE_SUPABASE_MAX_OBJECT_BYTES=50331648
# Keep-alive touch so a free project is not paused after 7 days of DB inactivity.
# Scheduled by backend/modal_app.py; set false to disable the run.
PROMPTCODE_SUPABASE_KEEPALIVE_ENABLED=true
PROMPTCODE_SUPABASE_KEEPALIVE_INTERVAL_SECONDS=21600
