# Copy to .env and fill in values
OPENAI_API_KEY=sk-your-key-here

# Backend config (all prefixed with PROMPTCODE_)
PROMPTCODE_DATABASE_URL=postgresql+asyncpg://promptcode:promptcode@localhost:5432/promptcode
PROMPTCODE_OPENAI_API_KEY=sk-your-key-here
PROMPTCODE_DEBUG=true
PROMPTCODE_SANDBOX_IMAGE=promptcode-sandbox:latest
PROMPTCODE_SANDBOX_TIMEOUT_SECONDS=120
PROMPTCODE_EVALUATION_NORMAL_RUNS=5
PROMPTCODE_EVALUATION_ADVERSARIAL_RUNS=2
